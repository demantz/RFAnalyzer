<!--
     ADS-B map marker: Surface vehicle, seen from above.
     Nose points up (0deg = north), matching the heading convention used for iconRotate in
     MaplibreView. A single solid shape, because the map draws it as a tintable SDF image; every
     subpath winds the same way so overlapping parts do not punch holes.
     Original artwork for RF Analyzer.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <path
      android:fillColor="#FF000000"
      android:pathData="M8,4 h8 a2,2 0 0,1 2,2 v12 a2,2 0 0,1 -2,2 h-8 a2,2 0 0,1 -2,-2 v-12 a2,2 0 0,1 2,-2 Z"/>
</vector>
